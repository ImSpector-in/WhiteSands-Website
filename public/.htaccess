# Static export (Next.js `output: "export"`) routing for Apache.
# Copied into the build output automatically (Next.js copies everything in
# public/ to the export root), so no manual setup needed beyond uploading
# the built files.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /about/ -> /about (drop trailing slash on directory-style URLs, except root)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about -> /about.html (serve the matching static page for clean URLs)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Custom 404 page generated by `next build`
ErrorDocument 404 /404.html
